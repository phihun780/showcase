# Sao chép file này thành .env.local rồi điền. .env.local KHÔNG nằm trong git.
# Lấy ở Cloudflare → R2 → Manage API Tokens (khoá bí mật chỉ hiện đúng một lần).
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=showcase
VITE_R2_PUBLIC_URL=https://pub-0ad262edfb6a4345a3bd61b2110c549c.r2.dev

# TUY CHON — chi dung cho o "dung luong R2" trong CMS.
#
# Han muc 10 GB mien phi tinh cho CA TAI KHOAN chu khong phai tung kho. Muon o
# do hien tong cua moi kho thi tao them mot khoa R2 CHI DOC, cap tren MOI kho,
# roi dien vao day. Khong dien thi o do chi dem kho cua trang nay va noi ro ra.
#
# CO Y tach khoi khoa chinh: khoa chinh co quyen ghi va xoa, noi no ra moi kho
# la CMS dung duoc ca du lieu cua webapp khac.
#
# Cloudflare -> R2 -> Manage API Tokens -> Create -> Permission "Object Read
# only", Specify bucket -> "Apply to all buckets".
VITE_R2_READ_ALL_ACCESS_KEY_ID=
VITE_R2_READ_ALL_SECRET_ACCESS_KEY=
